{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/valorant-emblem.png",
    "width": 26,
    "padding": {
      "top": 4,
      "right": 4,
      "left": 3
    }
  },
  "display": {
    "color": {
      "keys": "38;2;236;232;225"
    },
    "key": {
      "width": 0
    },
    "separator": " ",
    "percent": {
      "type": 11,
      "color": {
        "green": "38;2;61;214;198",
        "yellow": "38;2;232;196;106",
        "red": "38;2;255;70;85"
      }
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "▰",
        "total": "▱"
      },
      "border": {
        "left": "",
        "right": ""
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;255;70;85m{user-name}\u001b[0m\u001b[38;2;118;128;121m@\u001b[0m\u001b[1;38;2;236;232;225m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;255;70;85m◆\u001b[0m \u001b[1;38;2;236;232;225mA G E N T\u001b[0m \u001b[38;2;118;128;121m//\u001b[0m \u001b[38;2;61;214;198mRYOKU\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;118;128;121m╭─\u001b[0m \u001b[1;38;2;255;70;85mHARDWARE\u001b[0m \u001b[38;2;255;70;85m──────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mCPU    \u001b[0m",
      "format": "{name} · {cores-logical} threads"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mGPU    \u001b[0m",
      "detectionMethod": "pci",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m󰍛\u001b[0m  \u001b[1;38;2;236;232;225mMEM    \u001b[0m",
      "format": "{percentage-bar} {used} / {total}"
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mDISK   \u001b[0m",
      "format": "{size-percentage-bar} {size-used} / {size-total}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;118;128;121m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;118;128;121m├─\u001b[0m \u001b[1;38;2;255;70;85mSYSTEM\u001b[0m \u001b[38;2;255;70;85m────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mOS     \u001b[0m",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mKERNEL \u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mWM     \u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mSHELL  \u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mPKGS   \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;118;128;121m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;118;128;121m├─\u001b[0m \u001b[1;38;2;255;70;85mSESSION\u001b[0m \u001b[38;2;255;70;85m───────────────────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mUPTIME \u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;118;128;121m│\u001b[0m  \u001b[38;2;255;70;85m\u001b[0m  \u001b[1;38;2;236;232;225mTERM   \u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;118;128;121m╰─\u001b[0m \u001b[38;2;61;214;198mListos para jugar.\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "  \u001b[38;2;236;232;225m◆\u001b[0m \u001b[38;2;255;70;85m◆\u001b[0m \u001b[38;2;189;57;68m◆\u001b[0m \u001b[38;2;61;214;198m◆\u001b[0m \u001b[38;2;94;86;201m◆\u001b[0m \u001b[38;2;118;128;121m◆\u001b[0m"
    },
    "break"
  ]
}